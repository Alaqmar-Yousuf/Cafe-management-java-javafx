<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootPane" spacing="15" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafebliss.CafeController" styleClass="root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <children>
        <!-- Top Navigation Bar -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label text="Cafe Bliss - Order Management" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="analyticsButton" text="Analytics" onAction="#handleAnalytics" styleClass="button"/>
            <Button fx:id="tableButton" text="Table Management" onAction="#handleTableManagement" styleClass="button"/>
            <Button fx:id="inventoryButton" text="Inventory Management" onAction="#handleInventory" styleClass="button"/>
            <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" styleClass="button"/>
        </HBox>

        <!-- Main Body: Split into Left Menu and Right Order -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <!-- Left: Menu Catalog -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="380">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Menu Items" styleClass="section-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addItemButton" text="Add Item" onAction="#handleAddMenuItem" styleClass="button"/>
                    <Button fx:id="editItemButton" text="Edit Item" onAction="#handleEditMenuItem" styleClass="button"/>
                    <Button fx:id="deleteItemButton" text="Delete Item" onAction="#handleDeleteMenuItem" styleClass="button"/>
                </HBox>
                <ListView fx:id="menuListView" VBox.vgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Quantity:" styleClass="section-label"/>
                    <TextField fx:id="quantityField" promptText="Qty" prefWidth="100"/>
                    <Button fx:id="addButton" text="Add to Order" onAction="#handleAddItem" styleClass="button"/>
                </HBox>
            </VBox>

            <!-- Right: Current Order Details -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="500">
                <Label text="Current Order Details" styleClass="section-label"/>
                <TableView fx:id="orderTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="itemNameColumn" text="Item" prefWidth="160"/>
                        <TableColumn fx:id="quantityColumn" text="Qty" prefWidth="70"/>
                        <TableColumn fx:id="priceColumn" text="Price ($)" prefWidth="90"/>
                        <TableColumn fx:id="totalColumn" text="Total ($)" prefWidth="90"/>
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label fx:id="totalLabel" text="Total: $0.00" styleClass="total-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="placeOrderButton" text="Place Order &amp; Generate Receipt" onAction="#handlePlaceOrder" styleClass="place-order-button"/>
                </HBox>
            </VBox>
        </HBox>
    </children>
</VBox>
